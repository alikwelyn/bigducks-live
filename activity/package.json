{
  "name": "bigducks-discord-stream-activity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "smoke": "node scripts/smoke.mjs",
    "start": "node relay/server.js",
    "edge:dev": "wrangler dev --config edge-relay/wrangler.jsonc",
    "edge:deploy": "wrangler deploy --config edge-relay/wrangler.jsonc",
    "edge:tail": "wrangler tail bigducks-stream-relay"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "vite": "^6.0.11",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.0"
  }
}
